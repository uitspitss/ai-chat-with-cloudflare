{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@repo/schema": ["../packages/schema/src"]
    }
  },
  "include": ["**/*.ts", "playwright.config.ts"]
}
