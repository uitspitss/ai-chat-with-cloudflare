{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    // @repo/api-client 経由で AppType が D1Database / R2Bucket を参照する
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@repo/server": ["../../apps/server/src/index.ts"],
      "@repo/schema": ["../schema/src"],
      "@repo/api-client": ["../api-client/src"]
    }
  },
  "include": ["src"]
}
