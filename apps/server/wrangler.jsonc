{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chat-with-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // **ここは本番の値。** `wrangler deploy` は vars を本番へ上書きするので、
  // dev の値を置くと本番が壊れる。ローカルは `.dev.vars` が vars を上書きするので
  // これで困らない（`nr secrets:pull` で dev-secrets.enc から生成する）。
  // BETTER_AUTH_SECRET は秘密なのでここには置かない（.dev.vars / wrangler secret）。
  "vars": {
    "BETTER_AUTH_URL": "https://ai-chat-with-cloudflare.u7s.workers.dev",
    // ネイティブアプリは deep link scheme（apps/mobile の app.json）を Origin として
    // 送るので、入れておかないとサインインが CSRF として弾かれる。
    "TRUSTED_ORIGINS": "https://ai-chat-with-cloudflare.u7s.workers.dev,aichat://",
  },

  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
  },
  // AIChatAgent はメッセージ永続化とストリームバッファに SQLite を使うので必須。
  // 既存の tag は絶対に書き換えず、変更時は新しい tag を追加する。
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],

  // `wrangler d1 create` / `r2 bucket create` は binding を**追記**する。
  // 生成された ai_chat_with_cloudflare_db / _files は DB / BUCKET と同じ実体を
  // 指す重複なので消してある。id だけを既存の binding に入れること
  // （消し忘れると同じ D1 に 2 つの binding が張られ、片方は migrations_dir 無しになる）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-chat-with-cloudflare-db",
      "database_id": "06311c27-c6bd-41a8-886b-bd6282fda916",
      "migrations_dir": "drizzle/migrations",
    },
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ai-chat-with-cloudflare-files",
    },
  ],

  // 本番は web のビルド成果物を同じ Worker から配信する。
  // /api/* と /agents/*（WebSocket 含む）だけ Worker を先に通す。
  //
  // **dev ではこのディレクトリは空でよい。** SPA は Vite（:5173）が配り、
  // wrangler は /api と /agents しか見ないため。ただし wrangler は存在しない
  // ディレクトリを指されると起動前に落ちるので、dev スクリプトが mkdir している
  // （クリーンチェックアウトで `nr dev` が動かなくなるのを防ぐ）。
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"],
  },
}
