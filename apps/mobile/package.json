{
  "name": "@repo/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "REACT_NATIVE_PACKAGER_HOSTNAME=${REACT_NATIVE_PACKAGER_HOSTNAME:-localhost} expo start",
    "start": "REACT_NATIVE_PACKAGER_HOSTNAME=${REACT_NATIVE_PACKAGER_HOSTNAME:-localhost} expo start",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=${REACT_NATIVE_PACKAGER_HOSTNAME:-localhost} expo run:android",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=${REACT_NATIVE_PACKAGER_HOSTNAME:-localhost} expo run:ios",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "sh ./scripts/e2e.sh"
  },
  "dependencies": {
    "@better-auth/expo": "~1.6.30",
    "@cloudflare/ai-chat": "catalog:",
    "@expo/metro-runtime": "~57.0.9",
    "@repo/app-api": "workspace:*",
    "@repo/design-tokens": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "agents": "catalog:",
    "ai": "catalog:",
    "better-auth": "~1.6.30",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.6",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.2",
    "tailwindcss": "^4.3.3"
  }
}
