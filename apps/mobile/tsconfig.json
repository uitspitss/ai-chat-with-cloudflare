{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@repo/api-client": ["../../packages/api-client/src"],
      "@repo/server": ["../server/src/index.ts"],
      "@repo/app-api": ["../../packages/app-api/src"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "types.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
